{
  "name": "@blimu/nestjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/blimu-dev/blimu-ts"
  },
  "version": "1.1.2",
  "description": "NestJS integration library for Blimu authorization and entitlement system",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "nestjs",
    "authorization",
    "rbac",
    "entitlements",
    "blimu",
    "access-control"
  ],
  "peerDependencies": {
    "@blimu/backend": ">=1.1.2",
    "@nestjs/common": ">=10.0.0",
    "@nestjs/core": ">=10.0.0",
    "reflect-metadata": ">=0.1.13",
    "rxjs": ">=7.0.0"
  },
  "dependencies": {
    "@blimu/backend": "workspace:*",
    "@blimu/types": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.12",
    "@nestjs/core": "^11.1.12",
    "@types/node": "^25.0.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  },
  "packageManager": "yarn@4.12.0",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
