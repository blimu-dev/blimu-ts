{
  "name": "@blimu/client",
  "version": "1.1.2",
  "description": "TypeScript SDK for Blimu API (auto-generated)",
  "repository": {
    "type": "git",
    "url": "https://github.com/blimu-dev/blimu-ts"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./services/*": {
      "types": "./dist/services/*.d.ts",
      "import": "./dist/services/*.mjs",
      "require": "./dist/services/*.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.mjs",
      "require": "./dist/schema.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.mjs",
      "require": "./dist/utils.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/services/*.ts src/schema.ts src/schema.zod.ts src/client.ts src/utils.ts --format cjs,esm --dts --external @blimu/types",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "eslint --fix . && prettier --write .",
    "prepublishOnly": "npm run build && npm run typecheck || true",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@blimu/types": "^1.1.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "vitest": "^4.0.17"
  },
  "module": "dist/index.mjs",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
