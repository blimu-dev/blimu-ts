{
  "name": "@blimu/types",
  "version": "1.1.4",
  "description": "TypeScript type definitions for Blimu simple types",
  "repository": {
    "type": "git",
    "url": "https://github.com/blimu-dev/blimu-ts"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "d:build": "npm run build && npm run typecheck",
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "author": "viniciusdacal",
  "license": "MIT",
  "keywords": [
    "typescript",
    "types",
    "blimu"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
