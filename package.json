{
  "name": "blimu-ts-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Blimu TypeScript libraries monorepo",
  "repository": "https://github.com/blimu/blimu-ts",
  "author": "viniciusdacal",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "yarn@4.12.0",
  "volta": {
    "node": "25.2.1",
    "yarn": "4.12.0"
  },
  "files": [
    "packages/*/dist/**"
  ],
  "scripts": {
    "d:build": "yarn workspaces foreach -A run d:build",
    "build": "yarn workspaces foreach -At run build",
    "build:backend": "yarn workspace @blimu/backend build",
    "build:client": "yarn workspace @blimu/client build",
    "build:nestjs": "yarn workspace @blimu/nestjs build",
    "typecheck": "yarn workspaces foreach -A run typecheck",
    "lint": "yarn workspaces foreach -A run lint",
    "format": "yarn workspaces foreach -A run format",
    "clean": "yarn workspaces foreach -A run clean",
    "changeset": "changeset",
    "changeset:version": "changeset version && YARN_ENABLE_IMMUTABLE_INSTALLS=false yarn install",
    "changeset:publish": "yarn replace-workspace-deps && changeset publish",
    "version": "changeset version",
    "replace-workspace-deps": "node scripts/replace-workspace-deps.js",
    "publish": "yarn replace-workspace-deps && changeset publish",
    "link:packages": "node scripts/link-packages.js",
    "unlink:packages": "node scripts/link-packages.js reset",
    "check:portals": "node scripts/check-portals.js",
    "check:changesets": "node scripts/check-changesets.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0"
  }
}
