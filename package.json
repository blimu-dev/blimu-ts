{
  "name": "blimu-ts-monorepo",
  "private": true,
  "version": "0.4.5",
  "description": "Blimu TypeScript libraries monorepo",
  "repository": "https://github.com/blimu/blimu-ts",
  "author": "viniciusdacal",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "yarn@3.8.7",
  "volta": {
    "node": "24.1.0",
    "yarn": "3.8.7"
  },
  "files": [
    "packages/*/dist/**"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -A run build",
    "build:backend": "yarn workspace @blimu/backend build",
    "build:nestjs": "yarn workspace @blimu/nestjs build",
    "typecheck": "yarn workspaces foreach -A run typecheck",
    "lint": "yarn workspaces foreach -A run lint",
    "format": "yarn workspaces foreach -A run format",
    "clean": "yarn workspaces foreach -A run clean",
    "publish:backend": "yarn workspace @blimu/backend npm publish",
    "publish:nestjs": "yarn workspace @blimu/nestjs npm publish",
    "version": "yarn workspaces foreach -A version"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "prettier": "^3.0.0"
  }
}
