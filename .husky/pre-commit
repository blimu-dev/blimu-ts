#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Check for major bumps in changesets (must be first to catch before commit)
node scripts/check-changesets.js

# Run lint-staged for staged files
yarn lint-staged

# Run typecheck on all packages
yarn typecheck

# Check for portal: entries in resolutions (always check root package.json)
yarn check:portals
